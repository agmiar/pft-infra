Crear un Dockerfile en el Escritorio con lo siguiente:
FROM gns3/ipterm:latest
RUN apt-get update && apt-get install -y iptables && rm -rf /var/lib/apt/lists/*

Abrir una terminal desde el Escritorio y correr:
docker build -t pft/dummy-internet:1.0 .

# PARA CREAR EL CONTENEDOR
Edit --> Preferences
"Docker containers" --> "New"
(Existing Image)
    Name: pft/dummy-internet:1.0
    Adapters: 3
    Start command: vacío
    Console type: telnet

----------

# Click derecho en la instancia de Docker --> luego "Edit config"

auto eth0
iface eth0 inet static
address 200.0.0.9
netmask 255.255.255.252
post-up /bin/sh -c 'printf "nameserver 192.168.122.1\n" > /etc/resolv.conf'

auto eth1
iface eth1 inet static
address 200.0.0.13
netmask 255.255.255.252

auto eth2
iface eth2 inet dhcp
post-up sysctl -w net.ipv4.ip_forward=1
post-up ip route replace 200.0.0.0/30 via 200.0.0.10 dev eth0
post-up ip route replace 200.0.0.4/30 via 200.0.0.14 dev eth1
post-up iptables -A FORWARD -i eth0 -o eth2 -j ACCEPT
post-up iptables -A FORWARD -i eth1 -o eth2 -j ACCEPT
post-up iptables -A FORWARD -i eth2 -o eth0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
post-up iptables -A FORWARD -i eth2 -o eth1 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
post-up iptables -t nat -A POSTROUTING -s 200.0.0.0/30 -o eth2 -j MASQUERADE
post-up iptables -t nat -A POSTROUTING -s 200.0.0.4/30 -o eth2 -j MASQUERADE
post-up iptables -t nat -A POSTROUTING -s 200.0.0.12/30 -o eth2 -j MASQUERADE


